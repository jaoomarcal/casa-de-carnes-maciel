# Copie este arquivo para ".env" e preencha com os dados do seu projeto Supabase.
# IMPORTANTE: cada linha e "CHAVE=valor" -> NAO repita o nome da chave no valor.

# Supabase -> Project Settings -> Data API -> "Project URL"
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Supabase -> Project Settings -> API Keys -> "Publishable key" (comeca com sb_publishable_)
# (o formato antigo "anon key" / eyJhbGciOi... tambem funciona)
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Telefone do estabelecimento no formato internacional, so digitos (DDI + DDD + numero)
VITE_WHATSAPP_NUMERO=5517991316331
